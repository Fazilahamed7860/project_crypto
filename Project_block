Aim:
TO verify and ceate miniChain — A From-Scratch Blockchain & Cryptocurrency (Python, zero dependencies)
A working blockchain + cryptocurrency simulation built entirely with Python's standard library, so it runs anywhere with no pip install needed.

Core Functions:

blockchain.py

Block.compute_hash() — SHA-256 hash of a block's header fields
Block.compute_merkle_root() — tamper-evident summary of all transactions in the block
Blockchain.add_transaction(tx) — validates and queues a transaction into the mempool
Blockchain.mine_pending_transactions(miner_address) — runs Proof-of-Work, pays the block reward, appends the new block
Blockchain.adjust_difficulty() — retargets mining difficulty every 5 blocks based on actual vs. target block time
Blockchain.get_balance(address) — replays the whole chain to compute a wallet's balance
Blockchain.is_chain_valid() — walks the chain checking hashes, merkle roots, and links

wallet.py

Wallet() — generates a private key + derives a public address
Wallet.sign(message) — signs data with the private key
Transaction.sign_transaction(wallet) / Transaction.is_valid() — sign and validate spends

stats.py

chain_stats(bc) — total blocks/transactions, average block time, estimated hash rate, current reward, % of max supply mined, top balances, chain validity
print_stats(bc) — pretty-prints the above like a block explorer dashboard

programe:
~~~
"""
main.py
End-to-end demo of the mini-cryptocurrency system.

Run: python3 main.py
"""

import json
from blockchain import Blockchain
from wallet import Wallet, Transaction
from stats import print_stats, chain_stats


def send(bc: Blockchain, sender_wallet: Wallet, recipient_address: str, amount: float, fee: float = 0.1):
    tx = Transaction(sender_wallet.address, recipient_address, amount, fee)
    tx.sign_transaction(sender_wallet)
    ok = bc.add_transaction(tx)
    print(f"Transaction {'ACCEPTED' if ok else 'REJECTED'}: "
          f"{sender_wallet.address[:8]}... -> {recipient_address[:8]}...  amount={amount}")
    return ok


def main():
    print("Initializing blockchain (difficulty=4)...")
    bc = Blockchain(difficulty=4)

    alice = Wallet()
    bob = Wallet()
    carol = Wallet()
    miner = Wallet()

    print(f"Alice address : {alice.address}")
    print(f"Bob address   : {bob.address}")
    print(f"Carol address : {carol.address}")
    print(f"Miner address : {miner.address}\n")

    # --- Round 1: miner mines an empty block first to earn coins to spend ---
    print("Mining block #1 (no pending txs, just to reward the miner)...")
    bc.mine_pending_transactions(miner.address)

    # --- Round 2: miner sends coins to Alice and Bob ---
    send(bc, miner, alice.address, 20)
    send(bc, miner, bob.address, 10)
    print("Mining block #2...")
    bc.mine_pending_transactions(miner.address)

    # --- Round 3: Alice pays Carol, Bob pays Alice ---
    send(bc, alice, carol.address, 5)
    send(bc, bob, alice.address, 3)
    print("Mining block #3...")
    bc.mine_pending_transactions(miner.address)

    # --- Round 4: an invalid transaction (negative amount) gets rejected ---
    bad_tx = Transaction(alice.address, carol.address, -100)
    bad_tx.sign_transaction(alice)
    bc.add_transaction(bad_tx)  # should be rejected silently by add_transaction's validity check
    print("Mining block #4...")
    bc.mine_pending_transactions(miner.address)

    print("\nBalances:")
    for name, w in [("Alice", alice), ("Bob", bob), ("Carol", carol), ("Miner", miner)]:
        print(f"  {name:6}: {bc.get_balance(w.address):.4f} coins")

    print_stats(bc)

    # --- Export the clean, valid chain + stats as JSON, like a block explorer API would ---
    export = {
        "chain": [block.to_dict() for block in bc.chain],
        "stats": chain_stats(bc),
    }
    with open("chain_export.json", "w") as f:
        json.dump(export, f, indent=2, default=str)
    print("Full valid chain + stats exported to chain_export.json")

    # --- Tamper-detection demo (done AFTER export, so the exported file stays clean) ---
    print("\nTampering with block #2's data to prove immutability detection works...")
    bc.chain[2].transactions[0]["amount"] = 999999
    print(f"Chain valid after tampering? {bc.is_chain_valid()}  <-- should be False")


if __name__ == "__main__":
    main()
